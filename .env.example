# ============================================================================
# SGD Municipalidad de Santo Domingo - Configuración
# Copiar a .env FUERA del docroot (p. ej. /home/USUARIO/sgd/.env), permisos 600.
# Generar claves con los comandos indicados. NUNCA versionar .env ni secretos.
# ============================================================================
APP_NAME="SGD Santo Domingo"
APP_ENV=production
# php -r 'echo "base64:".base64_encode(random_bytes(32)),"\n";'
APP_KEY=
APP_DEBUG=false
APP_URL=https://sgd.santodomingo.cl
APP_LOCALE=es
APP_TIMEZONE=America/Santiago
LOG_CHANNEL=single
LOG_LEVEL=warning
# Solo si hay proxy/CDN delante (lista de IP separadas por coma). Vacío en hosting compartido directo.
TRUSTED_PROXIES=

# --- Ambiente: produccion (defecto) | pruebas.
# «pruebas» permite modos simulados (ClaveÚnica/FirmaGob/PISEE/DocDigital) y el ingreso con usuario y contraseña SOLO hasta la fecha indicada
# (AAAA-MM-DD, máximo 45 días desde hoy). Muestra un aviso permanente. NUNCA use datos reales en este ambiente.
SGD_AMBIENTE=produccion
SGD_ADMIN_2FA=true
SGD_ACCESO_PRUEBAS_HASTA=

# --- Base de datos (MySQL 8 / MariaDB 10.6+). Usuario con privilegios mínimos (ver README: SIN UPDATE/DELETE en audit_log)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpanelusr_sgd
DB_USERNAME=cpanelusr_sgdapp
DB_PASSWORD=

# --- Sesión (cookie __Host-sgd_session fija en config/session.php), cola y caché en BD (sin Redis)
SESSION_DRIVER=sgd_database
SESSION_LIFETIME=30
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Almacenamiento cifrado FUERA del docroot
SGD_STORAGE_PATH=/home/USUARIO/sgd_storage
# JSON con claves de 32 bytes en base64. La activa es FILE_ENCRYPTION_KEY_ID; las antiguas solo descifran (rotación).
# php -r 'echo json_encode(["k1"=>base64_encode(random_bytes(32))]),"\n";'
FILE_ENCRYPTION_KEY_ID=k1
FILE_ENCRYPTION_KEYS='{"k1":"REEMPLAZAR"}'
# Clave HMAC de la cadena de auditoría (>= 32 caracteres): php -r 'echo bin2hex(random_bytes(32)),"\n";'
AUDIT_HMAC_KEY=

# --- ClaveÚnica (OIDC). En producción CLAVEUNICA_MODE=real (mock está PROHIBIDO)
# Carpeta para claves JSON subidas desde el panel (vacío = ../sgd_secrets)
SGD_SECRETS_PATH=
# Directorio de funcionarios (base «sistemas_usuarios»): quien entra con ClaveÚnica y figura en ella es funcionario(a). También se configura desde Administración → APIs → Directorio.
DIRECTORIO_ENABLED=false
DIRECTORIO_HOST=
DIRECTORIO_PORT=3306
DIRECTORIO_DATABASE=sistemas_usuarios
DIRECTORIO_USERNAME=
DIRECTORIO_PASSWORD=
DIRECTORIO_TABLA=sistemas_users
DIRECTORIO_ROL_DEFECTO=funcionario
DIRECTORIO_CREAR_UNIDADES=true
# Ingreso de funcionarios sin ClaveÚnica con «username» y contraseña (hash `pass`) del directorio; nunca administración
DIRECTORIO_LOGIN_USUARIO=true
CLAVEUNICA_MODE=real
CLAVEUNICA_CLIENT_ID=
CLAVEUNICA_CLIENT_SECRET=
CLAVEUNICA_REDIRECT_URI=https://sgd.santodomingo.cl/auth/callback
# Logout URI registrada ante ClaveÚnica (esquema + autoridad + path, sin query). Si se omite se usa la portada del sitio.
CLAVEUNICA_LOGOUT_URI=https://sgd.santodomingo.cl/
# Ambiente activo y credenciales por ambiente (también se pueden ingresar desde Administración → APIs → ClaveÚnica). Sin las del ambiente se usan las generales de arriba.
CLAVEUNICA_AMBIENTE=produccion
CLAVEUNICA_SANDBOX_CLIENT_ID=
CLAVEUNICA_SANDBOX_CLIENT_SECRET=
CLAVEUNICA_SANDBOX_REDIRECT_URI=
CLAVEUNICA_SANDBOX_LOGOUT_URI=
CLAVEUNICA_QA_CLIENT_ID=
CLAVEUNICA_QA_CLIENT_SECRET=
CLAVEUNICA_QA_REDIRECT_URI=
CLAVEUNICA_QA_LOGOUT_URI=
CLAVEUNICA_PRODUCCION_CLIENT_ID=
CLAVEUNICA_PRODUCCION_CLIENT_SECRET=
CLAVEUNICA_PRODUCCION_REDIRECT_URI=
CLAVEUNICA_PRODUCCION_LOGOUT_URI=
CLAVEUNICA_INSTITUCION="I. Municipalidad de Santo Domingo"
CLAVEUNICA_APP_NOMBRE=
CLAVEUNICA_SITIO_WEB=https://gestor.santodomingo.cl/login

# --- FirmaGob API v2. Modos: test | prod  (mock está PROHIBIDO en producción)
FIRMAGOB_MODE=prod
FIRMAGOB_API_TOKEN_KEY=
# Credenciales propias de cada ambiente (reemplazan a las generales según el ambiente activo)
FIRMAGOB_TEST_API_TOKEN_KEY=
FIRMAGOB_TEST_SECRET=
FIRMAGOB_PROD_API_TOKEN_KEY=
FIRMAGOB_PROD_SECRET=
FIRMAGOB_SECRET=
FIRMAGOB_ENTITY="I. Municipalidad de Santo Domingo"
FIRMAGOB_PURPOSE="Propósito General"

# --- Inicio dual: quien ingresa como funcionario(a) también puede actuar como vecino(a) (mismo RUN, ClaveÚnica)
SGD_ESPACIO_DUAL=true

# --- Plazos: días administrativos = lunes a viernes sin feriados (true, por defecto) o corridos (false); aviso «por vencer» en días
SGD_PLAZOS_HABILES=true
SGD_PLAZOS_AVISO_DIAS=3

# --- Casilla Única: outbox (no envía; queda pendiente hasta registrar evidencia) | api (contrato A VALIDAR)
CASILLA_MODE=outbox
CASILLA_API_URL=
CASILLA_API_TOKEN=
# Alternativa al token fijo: OAuth2 client credentials (A VALIDAR con la guía de integración)
CASILLA_CLIENT_ID=
CASILLA_CLIENT_SECRET=
CASILLA_TOKEN_URL=
CASILLA_SCOPE=

# --- Correo institucional: Gmail API con cuenta de servicio + delegación de todo el dominio (scope gmail.send)
# Máximo de documentos por lote en «Mis firmas» (firma y visación masivas)
SGD_FIRMA_LOTE_MAX=25
# Aviso al ciudadano por cada movimiento de su solicitud (Casilla Única + copia por correo)
SGD_AVISOS_MOVIMIENTOS=true
MAIL_MAILER=gmail_api
GOOGLE_SERVICE_ACCOUNT_JSON=/home/USUARIO/sgd_secrets/gmail-sa.json
GOOGLE_MAIL_SENDER=no-responder@santodomingo.cl
GOOGLE_MAIL_RATE_PER_MINUTE=20
MAIL_FROM_ADDRESS=no-responder@santodomingo.cl
MAIL_FROM_NAME="Municipalidad de Santo Domingo"

# --- Asistente IA (OPCIONAL, apagado por defecto)
LLM_ENABLED=0
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# --- Codificador de instituciones y procesos del Estado
CODIFICADOR_INSTITUCION_CODIGO=PE-MUN-00243
# manual (CSV en /app/admin/codificador) | api (forma del JSON A VALIDAR)
CODIFICADOR_MODE=manual
# API pública del Codificador (vacío = https://codificacion.digital.gob.cl/api); versión e id de la codificación «Instituciones»
CODIFICADOR_VERSION=v1
CODIFICADOR_ID_CODIFICACION=1
CODIFICADOR_ID_CODIFICACION_PROCESOS=
CODIFICADOR_API_URL=
CODIFICADOR_API_TOKEN=

# --- PISEE (consumo de servicios del Estado). disabled | api   (mock solo desarrollo; prohibido en producción)
PISEE_MODE=disabled
PISEE_BASE_URL=
PISEE_HEADER_CLIENTE=
PISEE_VALOR_CLIENTE=
PISEE_MTLS_CERT=/home/USUARIO/sgd_secrets/pisee-cliente.pem
PISEE_MTLS_KEY=/home/USUARIO/sgd_secrets/pisee-cliente.key
PISEE_CA_BUNDLE=

# --- DocDigital (comunicaciones oficiales). outbox | demo (DemoDoc) | prod   (mock/demo prohibidos en producción)
DOCDIGITAL_MODE=outbox
DOCDIGITAL_URL_DEMO=https://api-demodoc.digital.gob.cl/api
DOCDIGITAL_URL_PROD=https://api-doc.digital.gob.cl/api
DOCDIGITAL_API_TOKEN=
# Credenciales OAuth2 «client credentials» (A VALIDAR con la especificación en api-doc.digital.gob.cl). Se pueden ingresar también en Administración → APIs e integraciones.
DOCDIGITAL_CLIENT_ID=
DOCDIGITAL_CLIENT_SECRET=
DOCDIGITAL_PROD_CLIENT_ID=
DOCDIGITAL_PROD_CLIENT_SECRET=
DOCDIGITAL_PROD_ENTIDAD_ID=
DOCDIGITAL_PROD_TIPO_DOCUMENTO_ID=
DOCDIGITAL_TOKEN_URL=
DOCDIGITAL_ENTIDAD_ID=
DOCDIGITAL_TIPO_DOCUMENTO_ID=
# Unidad que recibe las comunicaciones entrantes (se crea un expediente por cada una)
DOCDIGITAL_MAX_ANEXOS=10
DOCDIGITAL_UNIDAD_RECEPCION=SECMUN

# --- Repositorio de documentos: local (disco fuera del docroot) | drive (unidad compartida de Google Drive)
# Los archivos se guardan CIFRADOS (XChaCha20-Poly1305); Google Drive solo ve bytes opacos.
REPOSITORIO_MODO=local
# Ruta (fuera del docroot) al JSON de la cuenta de servicio, p. ej. /home/USUARIO/sgd_secrets/drive-sa.json (600). No va en el repositorio.
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_SHARED_DRIVE_ID=
# Carpeta raíz dentro de la unidad compartida (opcional; vacío = raíz de la unidad)
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# --- Conexiones (mapa y ranking de IP en Administración): contadores por hora, sin URL ni contenido. Retención en días (las IP son datos personales)
SGD_REGISTRAR_CONEXIONES=true
SGD_CONEXIONES_RETENCION_DIAS=90

# --- Reconocimiento de firmas electrónicas en PDF: ruta a un paquete PEM con las CA de confianza (prestadores acreditados). Vacío = integridad sí, confianza no verificada
SGD_FIRMA_CA_BUNDLE=

# --- Mantenedor de APIs: 1 = permite guardar secretos (cifrados con APP_KEY) en la BD. 0 (defecto) = los secretos solo en .env
SGD_API_SECRETOS_EN_BD=0

# --- Accesibilidad: correo/canal para reportar barreras (aparece en /accesibilidad)
SGD_ACCESIBILIDAD_CONTACTO=accesibilidad@santodomingo.cl
SGD_PUBLICO_RATE_POR_MINUTO=30
