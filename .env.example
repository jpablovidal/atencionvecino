# ============================================================================
# SGD Municipalidad de Santo Domingo - Configuración
# Copiar a .env FUERA del docroot (p. ej. /home/USUARIO/sgd/.env), permisos 600.
# Generar claves con los comandos indicados. NUNCA versionar .env ni secretos.
# ============================================================================
APP_NAME="SGD Santo Domingo"
APP_ENV=production
# php -r 'echo "base64:".base64_encode(random_bytes(32)),"\n";'
APP_KEY=
APP_DEBUG=false
APP_URL=https://sgd.santodomingo.cl
APP_LOCALE=es
APP_TIMEZONE=America/Santiago
LOG_CHANNEL=single
LOG_LEVEL=warning
# Solo si hay proxy/CDN delante (lista de IP separadas por coma). Vacío en hosting compartido directo.
TRUSTED_PROXIES=

# --- Base de datos (MySQL 8 / MariaDB 10.6+). Usuario con privilegios mínimos (ver README: SIN UPDATE/DELETE en audit_log)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpanelusr_sgd
DB_USERNAME=cpanelusr_sgdapp
DB_PASSWORD=

# --- Sesión (cookie __Host-sgd_session fija en config/session.php), cola y caché en BD (sin Redis)
SESSION_DRIVER=sgd_database
SESSION_LIFETIME=30
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Almacenamiento cifrado FUERA del docroot
SGD_STORAGE_PATH=/home/USUARIO/sgd_storage
# JSON con claves de 32 bytes en base64. La activa es FILE_ENCRYPTION_KEY_ID; las antiguas solo descifran (rotación).
# php -r 'echo json_encode(["k1"=>base64_encode(random_bytes(32))]),"\n";'
FILE_ENCRYPTION_KEY_ID=k1
FILE_ENCRYPTION_KEYS='{"k1":"REEMPLAZAR"}'
# Clave HMAC de la cadena de auditoría (>= 32 caracteres): php -r 'echo bin2hex(random_bytes(32)),"\n";'
AUDIT_HMAC_KEY=

# --- ClaveÚnica (OIDC). En producción CLAVEUNICA_MODE=real (mock está PROHIBIDO)
CLAVEUNICA_MODE=real
CLAVEUNICA_CLIENT_ID=
CLAVEUNICA_CLIENT_SECRET=
CLAVEUNICA_REDIRECT_URI=https://sgd.santodomingo.cl/claveunica/callback

# --- FirmaGob API v2. Modos: test | prod  (mock está PROHIBIDO en producción)
FIRMAGOB_MODE=prod
FIRMAGOB_API_TOKEN_KEY=
FIRMAGOB_SECRET=
FIRMAGOB_ENTITY="I. Municipalidad de Santo Domingo"
FIRMAGOB_PURPOSE="Propósito General"

# --- Casilla Única: outbox (no envía; queda pendiente hasta registrar evidencia) | api (contrato A VALIDAR)
CASILLA_MODE=outbox
CASILLA_API_URL=
CASILLA_API_TOKEN=

# --- Correo institucional: Gmail API con cuenta de servicio + delegación de todo el dominio (scope gmail.send)
MAIL_MAILER=gmail_api
GOOGLE_SERVICE_ACCOUNT_JSON=/home/USUARIO/sgd_secrets/gmail-sa.json
GOOGLE_MAIL_SENDER=no-responder@santodomingo.cl
GOOGLE_MAIL_RATE_PER_MINUTE=20
MAIL_FROM_ADDRESS=no-responder@santodomingo.cl
MAIL_FROM_NAME="Municipalidad de Santo Domingo"

# --- Asistente IA (OPCIONAL, apagado por defecto)
LLM_ENABLED=0
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# --- Codificador de instituciones y procesos del Estado
CODIFICADOR_INSTITUCION_CODIGO=
# manual (CSV en /app/admin/codificador) | api (forma del JSON A VALIDAR)
CODIFICADOR_MODE=manual
CODIFICADOR_API_URL=
CODIFICADOR_API_TOKEN=

# --- PISEE (consumo de servicios del Estado). disabled | api   (mock solo desarrollo; prohibido en producción)
PISEE_MODE=disabled
PISEE_BASE_URL=
PISEE_HEADER_CLIENTE=
PISEE_VALOR_CLIENTE=
PISEE_MTLS_CERT=/home/USUARIO/sgd_secrets/pisee-cliente.pem
PISEE_MTLS_KEY=/home/USUARIO/sgd_secrets/pisee-cliente.key
PISEE_CA_BUNDLE=

# --- DocDigital (comunicaciones oficiales). outbox | demo (DemoDoc) | prod   (mock/demo prohibidos en producción)
DOCDIGITAL_MODE=outbox
DOCDIGITAL_URL_DEMO=
DOCDIGITAL_URL_PROD=
DOCDIGITAL_API_TOKEN=
DOCDIGITAL_PATH_ENVIAR=
DOCDIGITAL_PATH_RECIBIDOS=
DOCDIGITAL_PATH_ACUSE=
# Unidad que recibe las comunicaciones entrantes (se crea un expediente por cada una)
DOCDIGITAL_UNIDAD_RECEPCION=SECMUN

# --- Mantenedor de APIs: 1 = permite guardar secretos (cifrados con APP_KEY) en la BD. 0 (defecto) = los secretos solo en .env
SGD_API_SECRETOS_EN_BD=0

# --- Accesibilidad: correo/canal para reportar barreras (aparece en /accesibilidad)
SGD_ACCESIBILIDAD_CONTACTO=accesibilidad@santodomingo.cl
